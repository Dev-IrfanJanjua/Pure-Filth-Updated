{% style %}
.cstm-page-banner-{{ section.id }} {
  position: relative;
  padding-top: {{ section.settings.padding_top_desktop }}px;
  padding-bottom: {{ section.settings.padding_bottom_desktop }}px;
  background-color: {{ section.settings.bg_color }};
  margin-top: {{ section.settings.margin_top }}px;
}

.cstm-page-banner__bg img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

.cstm-page-banner__content {
    position: absolute;
    z-index: 1;
    top: 50%;
    left: 50%;
    transform: translate(-50%, 0%);
}

.cstm-page-banner-{{ section.id }} .cstm-page-banner__content h1 {
    color: {{ section.settings.heading_color }};
    font-family: "PP Formula";
    font-size: {{ section.settings.font_size }}px;
    font-style: normal;
    font-weight: 700;
    line-height: {{ section.settings.font_size | plus: 4 }}px;
    letter-spacing: 1px;
    text-transform: uppercase;
    text-align: center;
}

@media (max-width: 749px) {
  .cstm-page-banner-{{ section.id }} {
    padding-top: {{ section.settings.padding_top_mobile }}px;
    padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
    margin-top: {{ section.settings.margin_top_mob }}px;
  }

  .mobile-banner-image {
    display: block !important;
  }

  .desktop-banner-image {
    display: none !important;
  }

  .cstm-page-banner-{{ section.id }} .cstm-page-banner__content h1 {
    font-size: {{ section.settings.font_size_mob }}px;
    line-height: {{ section.settings.font_size_mob | plus: 4 }}px;
}

.cstm-page-banner__content {
    left: 16px;
    right: 16px;
    transform: unset;
}

}
{% endstyle %}

<section class="cstm-page-banner cstm-page-banner-{{ section.id }}">
  
  <div class="cstm-page-banner__bg">
    
    {% if section.settings.desktop_image != blank %}
      {{
        section.settings.desktop_image
        | image_url: width: 2000
        | image_tag: class: 'desktop-banner-image', alt: section.settings.heading
      }}
    {% endif %}

    {% if section.settings.mobile_image != blank %}
      {{
        section.settings.mobile_image
        | image_url: width: 800
        | image_tag: class: 'mobile-banner-image', alt: section.settings.heading,
        style: 'display: none;'
      }}
    {% endif %}

  </div>

  {% if section.settings.heading != blank %}
      <div class="cstm-page-banner__content">
        <h1>{{ section.settings.heading | replace: '<p>', '' | replace: '</p>', '' }}</h1>
      </div>
  {% endif %}

</section>

{% schema %}
{
  "name": "Custom Page Banner",
  "settings": [
    {
      "type": "richtext",
      "id": "heading",
      "label": "Heading",
      "default": "<h1>Practice</h1>"
    },
    {
      "type": "range",
      "id": "font_size",
      "label": "Font Size",
      "min": 20,
      "max": 100,
      "step": 1,
      "default": 72
    },
    {
      "type": "range",
      "id": "font_size_mob",
      "label": "Font Size Mobile",
      "min": 20,
      "max": 100,
      "step": 1,
      "default": 40
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "image_picker",
      "id": "desktop_image",
      "label": "Desktop Banner Image"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Mobile Banner Image"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "label": "Padding Top Desktop",
      "min": 0,
      "max": 200,
      "step": 5,
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "label": "Padding Bottom Desktop",
      "min": 0,
      "max": 200,
      "step": 5,
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Padding Top Mobile",
      "min": 0,
      "max": 200,
      "step": 5,
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Padding Bottom Mobile",
      "min": 0,
      "max": 200,
      "step": 5,
      "default": 0
    },
    {
        "type": "header",
        "content": "Section Margin",
    },
    {
      "type": "range",
      "id": "margin_top",
      "label": "Margin Top",
      "min": -100,
      "max": 100,
      "step": 5,
      "default": -80
    },
    {
      "type": "range",
      "id": "margin_top_mob",
      "label": "Margin Top Mobile",
      "min": -100,
      "max": 100,
      "step": 5,
      "default": -70
    }
  ],
  "presets": [
    {
      "name": "Custom Page Banner"
    }
  ]
}
{% endschema %}
