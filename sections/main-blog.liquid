{% style %}

.blog-{{ section.id }}{
  padding-top: {{ section.settings.padding_top_desktop }}px !important;
  padding-bottom: {{ section.settings.padding_bottom_desktop }}px !important;
}

.cstm_blog .blog__head {
    display: none !important;
}

.cstm_blog .container {
    max-width: unset;
    padding: 0;
}

.cstm_blog .blog__articles-grid {
    grid-template-columns: repeat(4,1fr) !important;
    gap: 30px 15px;
}

.cstm_blog .card-article__content {
    padding: 12px 0 0;
}

.blog_author_image {
    width: 40px;
    height: 40px;
}

.blog_author_image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
}

.blog_author_info {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-top: 23px;
}

span.article-card__author {
    color: var(--Rich-Black, #000);
    font-family: "GT Cinetype";
    font-size: 15.77px;
    font-style: normal;
    font-weight: 400;
    line-height: 120%;
    letter-spacing: 0;
}

h3.card-article__title {
    color: var(--Rich-Black, #000);
    font-family: "PP Formula";
    font-size: 18px;
    font-style: normal;
    font-weight: 700;
    line-height: 120%;
    letter-spacing: 0.3px;
}

.media.card-article__media {
    position: relative;
    border-radius: 16px;
    overflow: hidden;
    aspect-ratio: 77 / 59;
}

.blog-media-abs {
    position: absolute;
    height: fit-content;
    bottom: 12px;
    z-index: 1;
    left: 12px;
    max-width: unset;
    width: fit-content;
    display: flex;
    align-items: center;
    gap: 4px;
}

span.article-card__date {
    color: #F7F9F2;
    text-align: center;
    font-family: "GT Cinetype";
    font-size: 11.828px;
    font-style: normal;
    font-weight: 700;
    line-height: 120%;
    border-radius: 29.569px;
    border: 1.478px solid #F7F9F2;
    padding: 7px 8px;
    display: inline-block;
}

span.article-tag {
    color: #F7F9F2;
    text-align: center;
    font-family: "GT Cinetype";
    font-size: 11.828px;
    font-style: normal;
    font-weight: 700;
    line-height: 120%;
    display: inline-block;
    border-radius: 29.569px;
    border: 1.478px solid #F7F9F2;
    padding: 7px 8px;
}

@media screen and (max-width: 768px) {
  .blog-{{ section.id }}{
    padding-top: {{ section.settings.padding_top_mobile }}px !important;
    padding-bottom: {{ section.settings.padding_bottom_mobile }}px !important;
  }

  .cstm_blog .blog__articles-grid {
    grid-template-columns: 1fr !important;
    gap: 16px;
}

}

{% endstyle %}